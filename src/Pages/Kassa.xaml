<Window x:Class="Restaurants.Classes.Kassa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Restaurants.Classes"
        mc:Ignorable="d"
        Title="Boxoro kafe" 
        WindowStartupLocation="CenterScreen" 
        WindowState="Maximized" 
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F8F9FA"
        Loaded="Window_Loaded">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#202020"/>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3F3F3F"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#B0BEC5"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Edit Icon Button Style -->
        <Style x:Key="EditIconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#42A5F5" Offset="0"/>
                        <GradientStop Color="#1976D2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#64B5F6" Offset="0"/>
                                            <GradientStop Color="#2196F3" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1976D2" Offset="0"/>
                                            <GradientStop Color="#0D47A1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Oddiy holat uchun Style (Default) -->
        <Style x:Key="TableButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#5C6BC0" CornerRadius="8">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="20" FontWeight="Bold" 
                                         Foreground="White" HorizontalAlignment="Center" 
                                         VerticalAlignment="Center" Margin="8,4"/>
                                <TextBlock x:Name="CountTextBlock" Text="{Binding Tag.OrderCountText, RelativeSource={RelativeSource TemplatedParent}}" 
                                         FontSize="14" Foreground="White" Margin="0,0,10,10"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="NameTextBlock" Text="{Binding Tag.ResponsibleName, RelativeSource={RelativeSource TemplatedParent}}" 
                                         FontSize="12" Foreground="White" Margin="10,10,0,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Zakaz bor, lekin tanlanmagan stol uchun Style -->
        <Style x:Key="BusyTableButtonStyle" TargetType="Button" BasedOn="{StaticResource TableButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#F44336" CornerRadius="8" Effect="{StaticResource CardShadow}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Stol (Band)" FontSize="12" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="12" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Bo'sh stol tanlanganda Style -->
        <Style x:Key="SelectedEmptyTableButtonStyle" TargetType="Button" BasedOn="{StaticResource TableButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#0F9D58" CornerRadius="8" Effect="{StaticResource CardShadow}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Stol" FontSize="12" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="12" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D8047"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0B6B3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Zakaz bo'lgan stol tanlanganda Style -->
        <Style x:Key="SelectedBusyTableButtonStyle" TargetType="Button" BasedOn="{StaticResource TableButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#F4B400" CornerRadius="8" Effect="{StaticResource CardShadow}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Stol (Band)" FontSize="12" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="12" Foreground="Black" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0A300"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC9200"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BackToTopButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#4CAF50" CornerRadius="20" Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="0" 
                Background="White" Effect="{StaticResource CardShadow}" Margin="0">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="lblRealTime" FontSize="22" FontWeight="Bold" Foreground="#212529" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnSettings" Content="Sozlamalar" Width="120" Height="40" Click="btnSettings_Click"
                                Background="#2196F3" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"/>
                        <Button x:Name="btnLogout" Content="Chiqish" Width="100" Height="40" Click="btnLogout_Click"
                                Background="#F44336" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Border Background="#F8F9FA" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#EEEEEE">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Restoran" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,5"/>
                                <TextBlock x:Name="lblRestoranValue" FontSize="16" FontWeight="Medium" Foreground="#212529" Margin="0,0,0,15" Text=""/>
                                <TextBlock Text="Ofitsiant" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,5"/>
                                <TextBlock x:Name="lblOfitsiantValue" FontSize="16" FontWeight="Medium" Foreground="#212529" Text=""/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Sana" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,5"/>
                                <TextBlock x:Name="lblSanaValue" FontSize="16" FontWeight="Medium" Foreground="#212529" Margin="0,0,0,15" Text=""/>
                                <TextBlock Text="Stol" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,5"/>
                                <TextBlock x:Name="lblStolValue" FontSize="16" FontWeight="Medium" Foreground="#212529" Text=""/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Vaqt" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,5"/>
                                <TextBlock x:Name="lblVaqtValue" FontSize="16" FontWeight="Medium" Foreground="#212529" Margin="0,0,0,15" Text=""/>
                                <TextBlock Text="Chek raqami" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,5"/>
                                <TextBlock x:Name="lblChekRaqamiValue" FontSize="16" FontWeight="Medium" Foreground="#212529" Text=""/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Loading Overlay -->
                    <Border x:Name="loadingOverlay" Background="#B0FFFFFF" CornerRadius="8" Visibility="Visible">
                        <Grid>
                            <Border Background="#80000000" CornerRadius="8" Margin="5">
                                <Border.Effect>
                                    <BlurEffect Radius="2" />
                                </Border.Effect>
                            </Border>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="80" Height="80" Background="White" CornerRadius="40" Effect="{StaticResource CardShadow}">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotate" CenterX="40" CenterY="40" />
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation 
                                                        Storyboard.TargetName="SpinnerRotate" 
                                                        Storyboard.TargetProperty="Angle" 
                                                        From="0" To="360" Duration="0:0:1" 
                                                        RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <Path Data="M 30,40 A 10,10 0 1 1 50,40" Stroke="#2196F3" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>
                                <TextBlock Text="Ma'lumotlar yuklanmoqda..." Margin="0,20,0,0" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Stollar" Style="{StaticResource HeaderTextStyle}" FontSize="16" Margin="0,0,0,10"/>
                    <ScrollViewer x:Name="tableScrollViewer" Grid.Row="1" 
                                  HorizontalScrollBarVisibility="Disabled" 
                                  VerticalScrollBarVisibility="Hidden" 
                                  ScrollChanged="tableScrollViewer_ScrollChanged">
                        <WrapPanel x:Name="tablesPanel" Orientation="Horizontal" 
                                   Width="{Binding ActualWidth, ElementName=tableScrollViewer}"/>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="4" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="3*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderThickness="1" BorderBrush="#EEEEEE" CornerRadius="8" Background="White" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header Row -->
                            <Grid Grid.Row="0" Background="#F8F9FA" Margin="0,0,0,0">
                                <Border BorderThickness="0,0,0,1" BorderBrush="#EEEEEE" Padding="20,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="№" FontWeight="SemiBold" Foreground="#3F3F3F" FontSize="16" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="ID" FontWeight="SemiBold" Foreground="#3F3F3F" FontSize="16" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Nomi" FontWeight="SemiBold" Foreground="#3F3F3F" FontSize="16" Margin="5,0,0,0"/>
                                        <TextBlock Grid.Column="3" Text="Tafsilotlar" FontWeight="SemiBold" Foreground="#3F3F3F" FontSize="16" Margin="5,0,0,0"/>
                                        <TextBlock Grid.Column="4" Text="Soni" FontWeight="SemiBold" Foreground="#3F3F3F" FontSize="16" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="5" Text="Narxi" FontWeight="SemiBold" Foreground="#3F3F3F" FontSize="16" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="6" Text="Jami summa" FontWeight="SemiBold" Foreground="#3F3F3F" FontSize="16" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="7" Text="Amallar" FontWeight="SemiBold" Foreground="#3F3F3F" FontSize="16" TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- List Items -->
                            <ListView Grid.Row="1" x:Name="lvItems" BorderThickness="0" Background="Transparent" FontSize="14" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,5"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" Padding="0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="180"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="100"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Padding="10">
                                                                <TextBlock Text="{Binding Index}" Foreground="#212529" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Border>

                                                            <Border Grid.Column="1" Padding="10">
                                                                <TextBlock Text="{Binding Id}" Foreground="#212529" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Border>

                                                            <Border Grid.Column="2" Padding="10,10,5,10">
                                                                <TextBlock Text="{Binding ProductShortName}" Foreground="#212529" FontSize="14" FontWeight="Medium" 
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                            </Border>

                                                            <Border Grid.Column="3" Padding="10">
                                                                <TextBlock Text="{Binding ContractorRequirement}" Foreground="#757575" FontSize="13" 
                                                                           VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding ContractorRequirement}"/>
                                                            </Border>

                                                            <Border Grid.Column="4" Padding="10">
                                                                <TextBlock Text="{Binding Quantity}" Foreground="#4CAF50" FontSize="14" FontWeight="Bold" 
                                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                            </Border>

                                                            <Border Grid.Column="5" Padding="10">
                                                                <TextBlock Text="{Binding FormattedEstimatedPrice}" Foreground="#757575" FontSize="14" 
                                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                            </Border>

                                                            <Border Grid.Column="6" Padding="10">
                                                                <TextBlock Text="{Binding FormattedAmount}" Foreground="#2196F3" FontSize="14" FontWeight="Bold" 
                                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                            </Border>

                                                            <!-- Defect Button -->
                                                            <Border Grid.Column="7" Padding="5,0,10,0">
                                                                <Button Click="btnRemoveDefectItem_Click" Tag="{Binding Id}" Width="28" Height="28" Cursor="Hand">
                                                                    <Button.ToolTip>
                                                                        <ToolTip Content="Yaroqsiz mahsulotni chiqarish"/>
                                                                    </Button.ToolTip>
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="border" Background="#FFE0E0" CornerRadius="4">
                                                                                <TextBlock Text="✕" FontSize="14" Foreground="#E53935" 
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#FFCDD2"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#EF9A9A"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E8F0FE"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#E3F2FD"/>
                                                            <Setter Property="BorderBrush" Value="#2196F3"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Index, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Odd}" Value="True">
                                                <Setter Property="Background" Value="#F5F8FA"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Index, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Even}" Value="True">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="8" Padding="15" BorderThickness="1" BorderBrush="#EEEEEE" MinWidth="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Summalar sohasi -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Jami summa:" FontSize="17" Foreground="#333333" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblAmountValue" Grid.Column="1" FontSize="17" FontWeight="Medium" Foreground="#333333" Text="0 so'm" 
                                            HorizontalAlignment="Right" Margin="10,0,0,0"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Xizmat haqi:" FontSize="17" Foreground="#333333" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblAdditinalPaymentValue" Grid.Column="1" FontSize="17" FontWeight="Medium" Foreground="#333333" Text="0 so'm" 
                                            HorizontalAlignment="Right" Margin="10,0,0,0"/>
                                </Grid>

                                <!-- Skidka qismi -->
                                <Grid Grid.Row="2" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Skidka:" FontSize="17" Foreground="#333333" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblDiscountValue" Grid.Column="1" FontSize="17" FontWeight="Medium" Foreground="#E91E63" Text="0 so'm"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,5,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="btnChangeDiscount" Grid.Column="2" Width="32" Height="32" Click="btnChangeDiscount_Click" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#E3F2FD" CornerRadius="6">
                                                    <TextBlock Text="✏️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0D47A1"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                
                                <Rectangle Grid.Row="3" Height="1" Fill="#DDDDDD" Margin="0,5,0,18"/>
                                
                                <!-- Jami summa qismi -->
                                <Grid Grid.Row="4" Margin="0,5,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="UMUMIY:" FontSize="20" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblTotalAmountValue" Grid.Column="1" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" Text="0 so'm"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <!-- To'lov usuli qismi -->
                                <Grid Grid.Row="5" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="To'lov usuli:" FontSize="17" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Border Grid.Column="1" x:Name="PaymentMethodBorder" CornerRadius="6" Padding="10,6" Background="#E3F2FD" MinHeight="36">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="lblPaymentMethod" Text="Наличности" FontSize="15" FontWeight="Medium" 
                                                    Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,5,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" x:Name="btnChangePaymentMethod" Width="26" Height="26" Click="btnChangePaymentMethod_Click" Padding="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#E3F2FD" CornerRadius="6">
                                                            <TextBlock Text="✏️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0D47A1"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                                
                                <!-- Tugmalar -->
                                <Grid Grid.Row="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" x:Name="btnCompleteOrder" Content="Buyurtmani tugatish" Height="Auto" MinHeight="45" MaxHeight="55" Padding="10,8" Click="btnCompleteOrder_Click" 
                                            Background="#2196F3" Foreground="White" Margin="0,0,0,12"
                                            FontSize="17" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Grid.Row="1" x:Name="btnPrint" Content="Chek chiqarish" Height="Auto" MinHeight="45" MaxHeight="55" Padding="10,8" Click="btnPrint_Click" 
                                            Background="#E3F2FD" Foreground="#2196F3"
                                            FontSize="17" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <Button x:Name="btnBackToTop" Content="⬆" Grid.Row="1" 
                Style="{StaticResource BackToTopButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Margin="0,0,20,20" Click="btnBackToTop_Click"
                Visibility="Collapsed"/>
    </Grid>
</Window>