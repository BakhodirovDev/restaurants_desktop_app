<Window x:Class="Restaurants.Pages.PrinterService"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Restaurants.Pages"
        mc:Ignorable="d"
        Title="printer sozlamalari" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#F8F9FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#202020"/>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#B0BEC5"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="printer sozlamalari" FontSize="24" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,10"/>
            <TextBlock Text="printer va internetga ulangan qurilmalarni izlash va sozlash" FontSize="14" Foreground="#6C757D"/>
            <Separator Margin="0,15,0,0"/>
        </StackPanel>
        
        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- Printer List -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E0E0E0"
                    Effect="{StaticResource CardShadow}" Margin="0,0,10,0">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="topilgan printerlar" Grid.Column="0" FontSize="18" FontWeight="SemiBold" Foreground="#3F3F3F" Margin="0,0,0,10"/>
                        
                        <Button x:Name="btnAddPrinter" Grid.Column="1" Content="+" Width="30" Height="30" 
                                Background="#4CAF50" Foreground="White" FontSize="18" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" ToolTip="Tanlangan printerni saqlash"
                                Click="btnAddPrinter_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#B0BEC5"/>
                                            <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    
                    <ListView x:Name="lvPrinters" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="lvPrinters_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Background" Value="#F8F9FA" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="#E0E0E0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                        <Setter Property="BorderBrush" Value="#2196F3" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F8E9" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        
                        <ListView.ItemTemplate>
                            <DataTemplate>
    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Background="#E8F5E9" Width="40" Height="40" CornerRadius="20" Margin="0,0,10,0">
                                        <TextBlock Text="🖨️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding ConnectionType}" Foreground="#757575" FontSize="12" Margin="0,0,10,0"/>
                                            <TextBlock Text="|" Foreground="#BDBDBD" FontSize="12" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#757575" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding IpAddress}" Foreground="#0288D1" FontSize="12" Margin="0,5,0,0" 
                                                   Visibility="{Binding IsNetworkPrinter, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <Border Grid.Column="2" Background="#F5F5F5" CornerRadius="4" Padding="5" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ConnectionType}" FontSize="10" Foreground="#616161"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <!-- Loading Indicator -->
                    <Grid x:Name="loadingGrid" Grid.Row="1" Background="#B0FFFFFF" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="60" Height="60" Background="White" CornerRadius="30" Effect="{StaticResource CardShadow}">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" CenterX="30" CenterY="30" />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation 
                                                    Storyboard.TargetName="SpinnerRotate" 
                                                    Storyboard.TargetProperty="Angle" 
                                                    From="0" To="360" Duration="0:0:1" 
                                                    RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Path Data="M 20,30 A 10,10 0 1 1 40,30" Stroke="#2196F3" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <TextBlock Text="printerlar qidirilmoqda..." Margin="0,15,0,0" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- No Printers Found -->
                    <StackPanel x:Name="noPrintersPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="printer topilmadi" FontSize="16" FontWeight="Medium" Margin="0,10,0,5" HorizontalAlignment="Center"/>
                        <TextBlock Text="printer qo'shish uchun qidiruvni boshlang" FontSize="14" Foreground="#757575" TextAlignment="Center" 
                                   TextWrapping="Wrap" MaxWidth="300"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Printer Details -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E0E0E0"
                    Effect="{StaticResource CardShadow}">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="printer haqida" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Foreground="#3F3F3F" Margin="0,0,0,10"/>
                    
                    <StackPanel Grid.Row="1" x:Name="printerDetailsPanel" Visibility="Visible">
                        <TextBlock x:Name="tbPrinterName" Text="printer tanlanmagan" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="holati:" Grid.Column="0" FontWeight="Medium" Foreground="#616161"/>
                            <TextBlock x:Name="tbStatus" Grid.Column="1" Text="-" Foreground="#212529"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="turi:" Grid.Column="0" FontWeight="Medium" Foreground="#616161"/>
                            <TextBlock x:Name="tbConnectionType" Grid.Column="1" Text="-" Foreground="#212529"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ip manzil:" Grid.Column="0" FontWeight="Medium" Foreground="#616161"/>
                            <TextBlock x:Name="tbIpAddress" Grid.Column="1" Text="-" Foreground="#212529"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="port:" Grid.Column="0" FontWeight="Medium" Foreground="#616161"/>
                            <TextBlock x:Name="tbPort" Grid.Column="1" Text="-" Foreground="#212529"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="model:" Grid.Column="0" FontWeight="Medium" Foreground="#616161"/>
                            <TextBlock x:Name="tbModel" Grid.Column="1" Text="-" Foreground="#212529"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="driver:" Grid.Column="0" FontWeight="Medium" Foreground="#616161"/>
                            <TextBlock x:Name="tbDriverName" Grid.Column="1" Text="-" Foreground="#212529"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="joylashuv:" Grid.Column="0" FontWeight="Medium" Foreground="#616161"/>
                            <TextBlock x:Name="tbLocation" Grid.Column="1" Text="-" Foreground="#212529"/>
                        </Grid>
                        
                        <Separator Margin="0,15,0,15"/>
                        
                        <Button x:Name="btnTest" Content="printer testini boshlash" Background="#4CAF50" Style="{StaticResource ActionButtonStyle}" 
                                Click="btnTest_Click" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                        
                        <Button x:Name="btnSetDefault" Content="asosiy printer qilib belgilash" Background="#2196F3" Style="{StaticResource ActionButtonStyle}" 
                                Click="btnSetDefault_Click" Margin="0,0,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1" x:Name="noPrinterSelectedPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="🖨️" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="printer tanlanmagan" FontSize="16" FontWeight="Medium" Margin="0,10,0,5" HorizontalAlignment="Center"/>
                        <TextBlock Text="ma'lumotlarni ko'rish uchun chap tomondagi ro'yxatdan printerni tanlang" FontSize="14" Foreground="#757575" 
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="250"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="btnClose" Content="yopish" Background="#757575" Style="{StaticResource ActionButtonStyle}" 
                                Click="btnClose_Click" Width="100"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,30">
            <Button x:Name="btnScanPrinters" 
                    Content="mahalliy printerlarni qidirish" 
                    Click="btnScanPrinters_Click"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#673AB7"
                    Padding="20,10"
                    Visibility="Visible"
                    Margin="0,0,10,0" />
            
            <Button x:Name="btnStopScan" Content="qidiruvni to'xtatish" Background="#F44336" Style="{StaticResource ActionButtonStyle}" 
                    Click="btnStopScan_Click" Padding="20,10" Visibility="Visible" IsEnabled="False" Margin="0,0,10,0"/>
            
            <Button x:Name="btnAddManualPrinter" Content="qo'lda qo'shish" Background="#2196F3" Style="{StaticResource ActionButtonStyle}" 
                    Click="btnAddManualPrinter_Click" Padding="20,10" Visibility="Visible" Margin="0,0,10,0"/>
            
            <Button x:Name="btnAddToSaved" Content="saqlanganlarga qo'shish" Background="#4CAF50" Style="{StaticResource ActionButtonStyle}" 
                    Click="btnAddPrinter_Click" Padding="20,10" Visibility="Visible" IsEnabled="False" Margin="0,0,10,0"/>
            
            <Button x:Name="btnMapCategories" Content="kategoriyalarga biriktirish" Background="#FF9800" Style="{StaticResource ActionButtonStyle}" 
                    Click="btnMapCategories_Click" Padding="20,10" Visibility="Visible" IsEnabled="False" Margin="0,0,10,0"/>
        </StackPanel>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#F5F5F5" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" 
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Padding="10,5">
            <TextBlock x:Name="tbStatusBar" Text="tayyorlangan" Foreground="#616161" FontSize="12"/>
        </Border>
    </Grid>
</Window>
